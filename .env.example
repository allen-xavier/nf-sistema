# Porta da aplicação
APP_PORT=3000
APP_URL=https://seu-dominio.com.br
CORS_ORIGINS=https://seu-dominio.com.br

# Admin inicial do sistema
APP_ADMIN_NAME=Administrador
APP_ADMIN_EMAIL=admin@exemplo.com
APP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Configuração do banco (usa o postgres da sua stack)
DB_HOST=pgvector
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-forte
DB_NAME=nf_sistema
DB_LOG_SQL=0
DB_SYNC_ALTER=0

# JWT
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# SMTP
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=
SMTP_ALLOW_INVALID_CERT=0
SMTP_VERIFY_ON_START=0
